<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.CAMERA"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <uses-feature android:name="android.hardware.camera" android:required="true"/>
  <application
      android:largeHeap="true"
      android:label="Photorealism"
      android:icon="@mipmap/ic_launcher"
      android:theme="@style/Theme.Realism"
      android:networkSecurityConfig="@xml/network_security_config"
      android:hardwareAccelerated="true">
    <meta-data
        android:name="com.google.android.gms.ads.APPLICATION_ID"
        android:value="ca-app-pub-4573680538268043~2423004381"/>
    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden"
        android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <!-- most references are found on the web, not shot on the phone, so
           the natural gesture is Share -> Photorealism straight out of
           Chrome, Pinterest or the gallery. Without these the app did not
           appear in the share sheet at all and the image had to be saved
           and then hunted for in the picker. -->
      <intent-filter>
        <action android:name="android.intent.action.SEND"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <data android:mimeType="image/*"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:mimeType="image/*"/>
      </intent-filter>
    </activity>
    <!-- RETIRED feature (Play Deceptive Behavior enforcement): these
         aliases once let the launcher icon follow the accent. Swapping
         required disabling the MainActivity launcher component, which
         Play rejects as icon-hiding. The aliases must still NEVER be
         removed: installs that swapped keep a valid launcher entry via
         their alias until the boot-time restore migrates them back. -->
    <activity-alias
        android:name=".IconA0"
        android:targetActivity=".MainActivity"
        android:icon="@mipmap/ic_launcher_0"
        android:label="Photorealism"
        android:exported="true"
        android:enabled="false">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity-alias>
    <activity-alias
        android:name=".IconA1"
